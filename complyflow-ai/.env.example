COMPOSE_PROJECT_NAME=complyflow

POSTGRES_DB=complyflow
POSTGRES_USER=complyflow
POSTGRES_PASSWORD=complyflow

API_PORT=8000
PROCESSOR_PORT=8001
WEB_PORT=5173

# Idle minutes (effective minimum 1440); demo expires_at stays absolute at creation +24h.
SESSION_LIFETIME=1440

# Set the same randomly generated secret for Laravel and FastAPI; no built-in secret.
PROCESSOR_HMAC_SECRET=
PROCESSOR_ANALYSIS_TIMEOUT_SECONDS=45
PROCESSOR_HTTP_TIMEOUT_SECONDS=60

# Local development remains deterministic by default. To opt into the real
# provider chain, set AI_PROVIDER=groq and provide a private GroqCloud key.
# GEMINI_API_KEY is optional and enables the secondary provider.
AI_PROVIDER=fake
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
AI_DAILY_REQUIREMENT_LIMIT=0
